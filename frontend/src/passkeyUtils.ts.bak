import * as cbor from 'cbor-web';

// P-256 curve constants (for the sanity check)
const P = 0xffffffff00000001000000000000000000000000ffffffffffffffffffffffffn;
const B = 0x5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604bn;

export interface P256Point {
  x: bigint;
  y: bigint;
  source: 'spki' | 'attestationObject';
}

// ---------- byte helpers (no Buffer: it does not exist in the browser) ----------
export function b64uToBytes(s: string): Uint8Array {
  const b64 = s.replace(/-/g, '+').replace(/_/g, '/').padEnd(Math.ceil(s.length / 4) * 4, '=');
  const bin = atob(b64);
  const out = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
  return out;
}

export function bytesToB64u(bytes: Uint8Array): string {
  let bin = '';
  bytes.forEach((b) => (bin += String.fromCharCode(b)));
  return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
}

export const bytesToHex = (b: Uint8Array) =>
  Array.from(b, (x) => x.toString(16).padStart(2, '0')).join('');

export const bytesToBigInt = (b: Uint8Array) => BigInt('0x' + bytesToHex(b));

export const toHex32 = (n: bigint) => '0x' + n.toString(16).padStart(64, '0');

// ---------- sanity check: is (x, y) really on P-256? Catches offset bugs ----------
export function isOnP256(x: bigint, y: bigint): boolean {
  const mod = (a: bigint) => ((a % P) + P) % P;
  return mod(y * y) === mod(x * x * x - 3n * x + B);
}

// ---------- Method 1 (recommended): SPKI from response.publicKey ----------
// SPKI for P-256 = 26-byte fixed header + 0x04 + X(32) + Y(32) = 91 bytes
const SPKI_P256_HEADER = '3059301306072a8648ce3d020106082a8648ce3d030107034200';

export function pointFromSpki(spkiB64u: string): P256Point {
  const der = b64uToBytes(spkiB64u);
  if (der.length !== 91 || bytesToHex(der.slice(0, 26)) !== SPKI_P256_HEADER) {
    throw new Error(`publicKey is not a P-256 SPKI (len=${der.length}). Is the credential ES256 (alg -7)?`);
  }
  if (der[26] !== 0x04) throw new Error('Expected uncompressed EC point (0x04)');
  return {
    x: bytesToBigInt(der.slice(27, 59)),
    y: bytesToBigInt(der.slice(59, 91)),
    source: 'spki',
  };
}

// ---------- Method 2: parse attestationObject -> authData -> COSE key ----------
export function pointFromAttestationObject(attestationObjectB64u: string): P256Point {
  const attBytes = b64uToBytes(attestationObjectB64u);
  // Note: cbor-web might use `decode` or `decodeFirst`. If `decodeFirstSync` fails, try `cbor.decode(attBytes)`
  const att: any = cbor.decode(attBytes); 
  const authData = new Uint8Array(att instanceof Map ? att.get('authData') : att.authData);

  const flags = authData[32];
  if ((flags & 0x40) === 0) throw new Error('AT flag not set: no attested credential data');

  let o = 32 + 1 + 4; // rpIdHash + flags + signCount
  o += 16; // aaguid
  const credIdLen = (authData[o] << 8) | authData[o + 1];
  o += 2 + credIdLen;

  const cose: any = cbor.decode(authData.slice(o));
  const get = (k: number) => (cose instanceof Map ? cose.get(k) : cose[k]);

  if (get(1) !== 2) throw new Error(`COSE kty=${get(1)}, expected 2 (EC2)`);
  if (get(3) !== -7) throw new Error(`COSE alg=${get(3)}, expected -7 (ES256)`);
  if (get(-1) !== 1) throw new Error(`COSE crv=${get(-1)}, expected 1 (P-256)`);

  const xb = new Uint8Array(get(-2));
  const yb = new Uint8Array(get(-3));
  if (xb.length !== 32 || yb.length !== 32) throw new Error('X/Y must be 32 bytes each');

  return { x: bytesToBigInt(xb), y: bytesToBigInt(yb), source: 'attestationObject' };
}

// Parse the ASN.1 DER signature from the browser into R and S values
export function parseASN1Signature(signature: Uint8Array) {
  let rStart = 4;
  let rLen = signature[3];
  let r = signature.slice(rStart, rStart + rLen);
  if (r.length === 33 && r[0] === 0) r = r.slice(1); // Remove leading zero

  let sStart = rStart + rLen + 2;
  let sLen = signature[sStart - 1];
  let s = signature.slice(sStart, sStart + sLen);
  if (s.length === 33 && s[0] === 0) s = s.slice(1); // Remove leading zero

  return {
    r: BigInt('0x' + Array.from(r).map(b => b.toString(16).padStart(2, '0')).join('')),
    s: BigInt('0x' + Array.from(s).map(b => b.toString(16).padStart(2, '0')).join(''))
  };
}